// Written by ui-craft's flutter_render.mjs on every run; .ui-craft/ is ignored by git.
// A widget test that starts the app, opens the screen asked for, and at each width saves a
// screenshot and runs Flutter's accessibility guidelines. Everything it finds goes to
// flutter-report.json in the output folder; flutter_render.mjs reads it and prints the summary.
// ignore_for_file: type=lint, deprecated_member_use, unused_import, unused_element, unnecessary_import, depend_on_referenced_packages, implementation_imports, invalid_use_of_protected_member, invalid_use_of_visible_for_testing_member

