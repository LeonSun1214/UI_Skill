const String _out = /*{{OUT}}*/;
const String _root = /*{{ROOT}}*/;
const String _package = /*{{PACKAGE}}*/;
const String _materialFonts = /*{{MATERIAL_FONTS}}*/;
const List<double> _widths = /*{{WIDTHS}}*/;
// a height per width, 0 for the default (812 for a phone, 1024 for a tablet, 900 for a desktop)
const List<double> _heights = /*{{HEIGHTS}}*/;
// the small phone's width and height (overflow only), empty for none
const List<double> _short = /*{{SHORT}}*/;
const bool _dark = /*{{DARK}}*/;
const bool _darkFirst = /*{{DARK_FIRST}}*/;
const bool _textScale = /*{{TEXT_SCALE}}*/;
const bool _network = /*{{NETWORK}}*/;
// what a person does after start, in order: 'route:/path', 'tap:TEXT', 'enter:FIELD=TEXT'
const List<String> _steps = /*{{STEPS}}*/;
// family -> font files fetched by flutter_render.mjs (google_fonts downloads them at run time; a test has no network)
const Map<String, List<String>> _extraFonts = /*{{EXTRA_FONTS}}*/;

final Map<String, Object?> _report = <String, Object?>{
  'passes': <Object?>[],
  'fonts': <Object?>[],
  'notes': <Object?>[],
  'unsettled': <Object?>[],
  'steps': <Object?>[],
  'errors': <Object?>[],
};
String _phase = 'start';

double _height(double w) => w < 600 ? 812 : (w < 1000 ? 1024 : 900);
double _heightAt(int i) => _heights[i] > 0 ? _heights[i] : _height(_widths[i]);
// '375' for a default height, '360x640' for one given
String _viewport(int i) => _heights[i] > 0 ? '${_widths[i].toInt()}x${_heights[i].toInt()}' : '${_widths[i].toInt()}';

void _write() {
  uicio.File('$_out/flutter-report.json')
      .writeAsStringSync(const uicc.JsonEncoder.withIndent(' ').convert(_report));
}

void _note(String s) => (_report['notes'] as List<Object?>).add(s);

// ---------------------------------------------------------------- fonts
Future<void> _loadFonts() async {
  final fonts = _report['fonts'] as List<Object?>;
  Future<void> load(String family, List<uictd.Uint8List> files) async {
    if (files.isEmpty) return;
    final loader = uicsv.FontLoader(family);
    for (final bytes in files) {
      loader.addFont(uica.Future<uictd.ByteData>.value(
          uictd.ByteData.view(bytes.buffer, bytes.offsetInBytes, bytes.lengthInBytes)));
    }
    await loader.load();
  }

  // Roboto: Material's text face on Android and the web. Apps do not bundle it, so a test has
  // none, and draws text it cannot find as solid boxes.
  final dir = uicio.Directory(_materialFonts);
  if (dir.existsSync()) {
    final roboto = dir
        .listSync()
        .whereType<uicio.File>()
        .where((f) {
          final n = f.uri.pathSegments.last;
          return n.startsWith('Roboto') && n.endsWith('.ttf');
        })
        .map((f) => f.readAsBytesSync())
        .toList();
    await load('Roboto', roboto);
    // San Francisco exists only on Apple platforms: Cupertino text is drawn in Roboto.
    for (final f in const <String>['CupertinoSystemText', 'CupertinoSystemDisplay', '.SF Pro Text',
        '.SF Pro Display', '.SF UI Text', '.SF UI Display']) {
      await load(f, roboto);
    }
    if (roboto.isNotEmpty) fonts.add('Roboto');
    final icons = uicio.File('$_materialFonts/MaterialIcons-Regular.otf');
    if (icons.existsSync()) await load('MaterialIcons', <uictd.Uint8List>[icons.readAsBytesSync()]);
  } else {
    _note('no Roboto: $_materialFonts is missing, so Material text is drawn as boxes');
  }
  // Every font the app and its packages declare, bundled by `flutter test` as the app bundles them.
  try {
    final manifest =
        uicc.json.decode(await uicsv.rootBundle.loadString('FontManifest.json')) as List<dynamic>;
    for (final dynamic entry in manifest) {
      final family = entry['family'] as String;
      final files = <uictd.Uint8List>[];
      for (final dynamic f in entry['fonts'] as List<dynamic>) {
        final data = await uicsv.rootBundle.load(f['asset'] as String);
        files.add(data.buffer.asUint8List(data.offsetInBytes, data.lengthInBytes));
      }
      await load(family, files);
      fonts.add(family);
    }
  } catch (e) {
    _note('FontManifest.json could not be read: ${'$e'.split('\n').first}');
  }
  for (final e in _extraFonts.entries) {
    await load(e.key, e.value.map((p) => uicio.File(p).readAsBytesSync()).toList());
  }
}

